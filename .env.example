# Superuser + default database, created by the postgres image on first boot.
POSTGRES_USER=movieshelf
POSTGRES_PASSWORD=change_me_super
POSTGRES_DB=movieshelf

# Application role passwords, consumed by db/init/01-roles.sh.
# symfony  -> owns raw + canonical (RW), reads mart (RO)
# analytics -> owns mart (RW), reads raw + canonical (RO)
SYMFONY_DB_PASSWORD=change_me_symfony
ANALYTICS_DB_PASSWORD=change_me_analytics

# Host user the php container runs as, so files written into the ./api bind-mount
# (composer.json, vendor/, var/) stay owned by you and not root.
# Check yours with `id -u` / `id -g`.
UID=1000
GID=1000

# Symfony secret, signing sessions and CSRF tokens. The committed api/.env
# leaves it empty on purpose; compose injects this value instead.
# Generate with: openssl rand -hex 32
APP_SECRET=

# ── Ingestion keys (#27) ─────────────────────────────────────────────────────
# Empty on purpose: CI copies this file verbatim, and the live-provider tests
# skip themselves when a key is missing, so a fork with no secrets still passes.
# Everything else is covered by recorded fixtures. See api/README.md.

# NYT Books API (developer.nytimes.com — enable "Books API" on the app).
# Only the key is used; the app id and api name are console metadata.
NYT_KEY=

# TMDB API v3 (themoviedb.org/settings/api). The v3 key, not the v4 read token.
TMDB_KEY=
