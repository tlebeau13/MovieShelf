# Superuser + default database, created by the postgres image on first boot.
POSTGRES_USER=cineshelf
POSTGRES_PASSWORD=change_me_super
POSTGRES_DB=cineshelf

# Application role passwords, consumed by db/init/01-roles.sh.
# symfony  -> owns raw + canonical (RW), reads mart (RO)
# analytics -> owns mart (RW), reads raw + canonical (RO)
SYMFONY_DB_PASSWORD=change_me_symfony
ANALYTICS_DB_PASSWORD=change_me_analytics

# Host user the php container runs as, so files written into the ./api bind-mount
# (composer.json, vendor/, var/) stay owned by you and not root.
# Check yours with `id -u` / `id -g`.
UID=1000
GID=1000
